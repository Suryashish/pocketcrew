# --- Required ---------------------------------------------------------------

# Gemma API key from Google AI Studio (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token from @BotFather (send it /newbot): https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# --- Optional ---------------------------------------------------------------

# Which Gemma model to use. Must be a Gemma model; anything else is refused.
LLM_MODEL=gemma-3-27b-it

# Extra output tokens reserved for models that reason before answering
# (Gemma 4). Defaults to 2560 for those and 0 for Gemma 2/3.
# LLM_THINKING_TOKENS=2560

# Where people reach the dashboard. Use your https:// domain in production.
PUBLIC_URL=http://localhost:8000
PORT=8000

# Signs login sessions. Generated and stored in the database when left empty.
SECRET_KEY=

# Database password (the database is not exposed outside Docker).
POSTGRES_PASSWORD=pocketcrew

# Use a hosted Postgres (Neon, Supabase, RDS) instead of the bundled container.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to false to stop new accounts being created.
ALLOW_SIGNUPS=true
MAX_AGENTS_PER_USER=12

# Agent tools: web search plus a shared sandbox container for running commands
# and serving previews. Set to false to turn tools off for everyone.
TOOLS_ENABLED=true
SANDBOX_MEMORY=2g

# Optional: Firecrawl for scraping, search and crawling (https://firecrawl.dev).
# It renders JavaScript-heavy sites and returns clean Markdown. Without a key,
# agents use a built-in page reader, DuckDuckGo search and a basic crawler.
FIRECRAWL_API_KEY=
SANDBOX_CPUS=2

# Run Gemma locally with Ollama instead of Google AI Studio:
#   docker compose --profile local up -d
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=gemma3:4b
